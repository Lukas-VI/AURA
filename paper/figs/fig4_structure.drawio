        <mxCell id="n1" value="训练：全局 = 监督对比（label=source_id，τ=0.2，XBM 4096）+ VICReg；局部 A = 合成仿射自监督 InfoNCE；局部 B = ImageNet 预训练、主干冻结" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=10;fontFamily=Microsoft YaHei;align=left;spacingLeft=8" parent="1" vertex="1">
